# Copy this file to .env and fill in your values.
# .env is ignored by Git, so passwords and API keys stay off GitHub.

APP_NAME=AGUS
APP_ENV=local
APP_DEBUG=true
# Leave empty to auto-detect (works in XAMPP subfolders)
APP_URL=
APP_TIMEZONE=Asia/Manila

# mysql (XAMPP/MariaDB) or sqlite (no server needed)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agus
DB_USERNAME=root
DB_PASSWORD=
# Only used when DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/database.sqlite

LOG_REQUESTS=true

# External APIs
WEATHER_API_URL=https://api.open-meteo.com/v1
WEATHER_LAT=15.1450
WEATHER_LON=120.5887
GEOCODING_API_URL=https://nominatim.openstreetmap.org
# Name your app and add your email, as Nominatim's usage policy asks
GEOCODING_USER_AGENT="Replate/1.0 (IPT10 student project; you@example.com)"
EXAMPLE_API_URL=
EXAMPLE_API_KEY=
